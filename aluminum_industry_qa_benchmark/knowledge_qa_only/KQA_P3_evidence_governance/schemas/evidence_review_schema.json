{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"KQA claim-evidence review record (proposal)",
  "type":"object",
  "required":["claim_id","question_id","claim_text","support_label","evidence_links","applicability","review_round","item_version"],
  "properties":{
    "claim_id":{"type":"string","pattern":"^CLM-[A-Z0-9-]+$"},
    "question_id":{"type":"string","pattern":"^K[0-9]{3}$"},
    "claim_text":{"type":"string"},
    "claim_role":{"enum":["core_conclusion","mechanism","parameter_relation","condition","assumption","limitation"]},
    "support_label":{"enum":["SUPPORTED","CONTRADICTED","PARTIALLY_SUPPORTED","CONDITIONAL","INSUFFICIENT","CONFLICTED"]},
    "evidence_links":{"type":"array","minItems":1,"items":{"type":"object","required":["evidence_id","source_id","location","support_scope"],"properties":{"evidence_id":{"type":"string"},"source_id":{"type":"string"},"location":{"type":"string"},"support_scope":{"enum":["direct","contextual","limiting","contradicting"]}}}},
    "applicability":{"type":"string"},"assumptions":{"type":"array","items":{"type":"string"}},
    "contradictory_evidence_ids":{"type":"array","items":{"type":"string"}},
    "review_round":{"type":"string"},"item_version":{"type":"string"},"reviewer_id":{"type":"string"}
  }
}
